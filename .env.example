# Same Supabase project already used by eduteach-ingest-service /
# eduteach-textbook-api (reuse those existing credentials).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Storage bucket name -- must exist and be PUBLIC before this service can
# serve anything (see README "Setup" section for the exact steps).
SIMULATION_BUCKET=simulations

# Separate bucket for generated prep-sheet PDFs (also PUBLIC, same project).
PREP_SHEET_BUCKET=prep-sheets

# This service's own public URL -- used to build the links it hands back.
# Only needs setting if Render doesn't give this service exactly this URL.
PUBLIC_BASE_URL=https://eduteach-simulation-host.onrender.com

PORT=8000
